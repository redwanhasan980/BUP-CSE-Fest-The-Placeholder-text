# GridWise LLM — environment variables (names only, NO values here)
# Copy to .env and fill in. .env is git-ignored.

# --- Primary LLM provider (required) ---
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-120b

# --- Secondary LLM provider (optional; leave key empty to disable) ---
# Free key: https://aistudio.google.com/apikey (no billing required)
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_SECONDARY_MODEL=gemini-2.0-flash

# --- Tunables ---
LLM_TIMEOUT_SECONDS=8
LLM_MAX_REPAIR_ATTEMPTS=1
ENABLE_RULE_FALLBACK=true
REQUEST_DEADLINE_SECONDS=25
PORT=8000
LOG_LEVEL=INFO
